{
  "name": "@baosky/plugin-registry",
  "version": "1.0.250201",
  "description": "BaoSky - BSX Registry",
  "dependencies": {
    "@theia/core": "alpha",
    "@theia/filesystem": "alpha",
    "@theia/navigator": "alpha",
    "@theia/ovsx-client": "alpha",
    "@baosky/plugin-host": "alpha",
    "@baosky/plugin-vscode": "alpha",
    "@theia/preferences": "alpha",
    "@theia/workspace": "alpha",
    "limiter": "^2.1.0",
    "luxon": "^2.4.0",
    "p-debounce": "^2.1.0",
    "semver": "^7.5.4",
    "tslib": "^2.6.2",
    "husky": "^8.0.3",
    "@baosky/platform": "alpha"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "theia-extension"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/common/bsx-registry-common-module",
      "backend": "lib/common/bsx-registry-common-module"
    },
    {
      "frontend": "lib/browser/bsx-registry-frontend-module",
      "backend": "lib/node/bsx-registry-backend-module"
    }
  ],
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-theia/theia.git"
  },
  "bugs": {
    "url": "https://github.com/eclipse-theia/theia/issues"
  },
  "homepage": "https://github.com/eclipse-theia/theia",
  "files": [
    "lib",
    "src",
    "src/**/*.json",
    "src/**/*.css",
    "src/**/*.svg",
    "src/**/*.png"
  ],
  "scripts": {
    "prepare": "yarn run clean && yarn run build && yarn husky install && yarn hookchmod",
    "hookchmod": "chmod 777 .husky/*",
    "clean": "rimraf lib",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest"
  },
  "devDependencies": {
    "@types/luxon": "^2.3.2",
    "typescript": "5.7.3",
    "jest-html-reporters": "^3.1.4",
    "jest-sonar": "^0.2.16",
    "@types/jest": "^29.5.0",
    "@types/sinon": "^10.0.14",
    "@types/object-hash": "3.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-junit": "^15.0.0",
    "sinon": "^15.0.4",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1"
  },
  "nyc": {
    "extends": "../../configs/nyc.json"
  }
}
