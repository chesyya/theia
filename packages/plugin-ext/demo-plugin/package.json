{
  "name": "demo-plugin",
  "displayName": "Demo Plugin",
  "description": "A demo plugin for help documentation test",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "demo-plugin.hello",
        "title": "Hello from Demo Plugin",
        "category": "Demo Plugin"
      },
      {
        "command": "demo-plugin.settings",
        "title": "Plugin Settings",
        "category": "Demo Plugin"
      }
    ],
    "menus": {
      "menubar/plugin": [
        {
          "command": "demo-plugin.hello",
          "group": "navigation@1"
        },
        {
          "command": "demo-plugin.settings",
          "group": "navigation@2"
        }
      ]
    },
    "helpDocumentation": {
      "basePath": "./",
      "main": {
        "path": "HELPDOC.md",
        "commands": [
          "demo-plugin.hello"
        ]
      },
      "pages": [
        {
          "path": "api.md",
          "commands": [
            "demo-plugin.settings"
          ]
        },
        {
          "path": "examples.md"
        }
      ],
      "title": "Demo Plugin Documentation"
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "html-escaper": "^3.0.3",
    "marked": "^16.0.0"
  }
}
