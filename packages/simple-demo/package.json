{
  "name": "simple-demo",
  "displayName": "Simple Demo Plugin",
  "description": "Simple plugin with frontend and backend functionality",
  "version": "1.0.0",
  "publisher": "theia",
  "engines": {
    "theiaPlugin": "latest"
  },
  "theiaPlugin": {
    "backend": "./out/backend.js",
    "frontend": "./src/frontend-direct.js"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "simpleDemo.frontend.showMessage",
        "title": "Frontend: Show Message",
        "category": "Simple Demo"
      },
      {
        "command": "simpleDemo.frontend.callBackend",
        "title": "Frontend: Call Backend",
        "category": "Simple Demo"
      },
      {
        "command": "simpleDemo.backend.getSystemInfo",
        "title": "Backend: Get System Info",
        "category": "Simple Demo"
      },
      {
        "command": "simpleDemo.backend.heavyTask",
        "title": "Backend: Perform Heavy Task",
        "category": "Simple Demo"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "simpleDemo.frontend.showMessage",
          "group": "navigation"
        },
        {
          "command": "simpleDemo.backend.getSystemInfo",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^14.0.0",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "@theia/plugin": "latest"
  }
}
