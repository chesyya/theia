<?xml version="1.0" encoding="UTF-8"?>
<!-- Theia 插件细粒度 API 方法权限配置 -->
<Resources>

  <!-- 插件的 API 方法级别权限配置 -->
  <Resource>
    <ResourceID>publisher.my-plugin</ResourceID>
    <TargetType>Plugin</TargetType>
    <ResourceName zh="示例插件" en="Example Plugin"/>

    <!-- 全局默认策略 -->
    <GlobalPolicy>
      <!-- 默认策略: Allow(允许), Deny(拒绝), Ask(询问用户) -->
      <DefaultAction>Deny</DefaultAction>
      <!-- 未配置的 API 是否允许 -->
      <AllowUnlistedApis>false</AllowUnlistedApis>
      <!-- 是否记录所有 API 调用 -->
      <LogAllCalls>true</LogAllCalls>
    </GlobalPolicy>

    <!-- API 方法权限列表 -->
    <ApiMethods>

      <!-- ==================== window 命名空间 ==================== -->

      <!-- window.showInformationMessage -->
      <ApiMethod>
        <Namespace>window</Namespace>
        <MethodName>showInformationMessage</MethodName>
        <Attributes>
          <Attribute key="Allowed" zh="是否允许" en="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" zh="执行动作" en="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxCallsPerMinute" zh="每分钟最大调用" en="Max calls per minute" type="number" min="0" max="1000" default="20"/>
          <Attribute key="RequireUserApproval" zh="需要用户批准" en="Require user approval" type="boolean" default="false"/>
          <Attribute key="AllowModalOption" zh="允许模态对话框选项" en="Allow modal option" type="boolean" default="false"/>
          <Attribute key="MaxMessageLength" zh="最大消息长度" en="Max message length" type="number" min="1" max="10000" default="500"/>
          <Attribute key="MaxButtonCount" zh="最大按钮数" en="Max button count" type="number" min="0" max="10" default="3"/>
        </Attributes>
      </ApiMethod>

      <!-- window.showWarningMessage -->
      <ApiMethod>
        <Namespace>window</Namespace>
        <MethodName>showWarningMessage</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="15"/>
          <Attribute key="RequireUserApproval" type="boolean" default="false"/>
        </Attributes>
      </ApiMethod>

      <!-- window.showErrorMessage -->
      <ApiMethod>
        <Namespace>window</Namespace>
        <MethodName>showErrorMessage</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="10"/>
        </Attributes>
      </ApiMethod>

      <!-- window.showInputBox -->
      <ApiMethod>
        <Namespace>window</Namespace>
        <MethodName>showInputBox</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Ask"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="10"/>
          <Attribute key="RequireUserApproval" type="boolean" default="true"/>
          <Attribute key="AllowPasswordInput" zh="允许密码输入" en="Allow password input" type="boolean" default="false"/>
        </Attributes>
      </ApiMethod>

      <!-- window.showQuickPick -->
      <ApiMethod>
        <Namespace>window</Namespace>
        <MethodName>showQuickPick</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="20"/>
          <Attribute key="MaxItems" zh="最大选项数" en="Max items" type="number" default="100"/>
        </Attributes>
      </ApiMethod>

      <!-- window.createWebviewPanel -->
      <ApiMethod>
        <Namespace>window</Namespace>
        <MethodName>createWebviewPanel</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="false"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Ask"/>
          <Attribute key="MaxWebviews" zh="最大WebView数" en="Max webviews" type="number" default="2"/>
          <Attribute key="RequireUserApproval" type="boolean" default="true"/>
          <Attribute key="AllowScripts" zh="允许执行脚本" en="Allow scripts" type="boolean" default="false"/>
          <Attribute key="AllowedDomains" zh="允许的域名" en="Allowed domains" type="string" default=""/>
        </Attributes>
      </ApiMethod>

      <!-- window.createTerminal -->
      <ApiMethod>
        <Namespace>window</Namespace>
        <MethodName>createTerminal</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="false"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Deny"/>
          <Attribute key="RequireUserApproval" type="boolean" default="true"/>
          <Attribute key="MaxTerminals" type="number" default="2"/>
        </Attributes>
      </ApiMethod>

      <!-- window.showTextDocument -->
      <ApiMethod>
        <Namespace>window</Namespace>
        <MethodName>showTextDocument</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="30"/>
        </Attributes>
      </ApiMethod>

      <!-- ==================== workspace 命名空间 ==================== -->

      <!-- workspace.openTextDocument -->
      <ApiMethod>
        <Namespace>workspace</Namespace>
        <MethodName>openTextDocument</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="50"/>
          <Attribute key="AllowedPaths" zh="允许的路径模式" en="Allowed path patterns" type="string" default="**/*"/>
          <Attribute key="DeniedPaths" zh="禁止的路径模式" en="Denied path patterns" type="string" default="**/.env,**/.git/**"/>
          <Attribute key="MaxFileSize" zh="最大文件大小(字节)" en="Max file size (bytes)" type="number" default="10485760"/>
        </Attributes>
      </ApiMethod>

      <!-- workspace.findFiles -->
      <ApiMethod>
        <Namespace>workspace</Namespace>
        <MethodName>findFiles</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="20"/>
          <Attribute key="MaxResults" zh="最大结果数" en="Max results" type="number" default="1000"/>
          <Attribute key="AllowedPaths" type="string" default="**/*"/>
        </Attributes>
      </ApiMethod>

      <!-- workspace.getConfiguration -->
      <ApiMethod>
        <Namespace>workspace</Namespace>
        <MethodName>getConfiguration</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="AllowedScopes" zh="允许的作用域" en="Allowed scopes" type="string" default="Self"/>
          <Attribute key="AllowReadOtherConfigs" zh="允许读取其他配置" en="Allow reading other configs" type="boolean" default="false"/>
        </Attributes>
      </ApiMethod>

      <!-- workspace.applyEdit (敏感操作) -->
      <ApiMethod>
        <Namespace>workspace</Namespace>
        <MethodName>applyEdit</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="false"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Ask"/>
          <Attribute key="RequireUserApproval" type="boolean" default="true"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="10"/>
          <Attribute key="MaxEditSize" zh="最大编辑大小(字符)" en="Max edit size (chars)" type="number" default="10000"/>
        </Attributes>
      </ApiMethod>

      <!-- workspace.createFileSystemWatcher -->
      <ApiMethod>
        <Namespace>workspace</Namespace>
        <MethodName>createFileSystemWatcher</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxWatchers" type="number" default="100"/>
          <Attribute key="AllowedPaths" type="string" default="**/src/**"/>
        </Attributes>
      </ApiMethod>

      <!-- ==================== commands 命名空间 ==================== -->

      <!-- commands.registerCommand -->
      <ApiMethod>
        <Namespace>commands</Namespace>
        <MethodName>registerCommand</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxCommands" zh="最大注册命令数" en="Max registered commands" type="number" default="20"/>
          <Attribute key="CommandPrefix" zh="命令前缀要求" en="Required command prefix" type="string" default="extension."/>
        </Attributes>
      </ApiMethod>

      <!-- commands.executeCommand -->
      <ApiMethod>
        <Namespace>commands</Namespace>
        <MethodName>executeCommand</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="100"/>
          <Attribute key="AllowedCommands" zh="允许的命令列表" en="Allowed commands" type="string" default=""/>
          <Attribute key="DeniedCommands" zh="禁止的命令列表" en="Denied commands" type="string" default="workbench.action.reloadWindow,workbench.action.quit"/>
          <Attribute key="RequireApprovalForSensitive" zh="敏感命令需批准" en="Require approval for sensitive" type="boolean" default="true"/>
        </Attributes>
      </ApiMethod>

      <!-- commands.getCommands -->
      <ApiMethod>
        <Namespace>commands</Namespace>
        <MethodName>getCommands</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="10"/>
        </Attributes>
      </ApiMethod>

      <!-- ==================== languages 命名空间 ==================== -->

      <!-- languages.registerCompletionItemProvider -->
      <ApiMethod>
        <Namespace>languages</Namespace>
        <MethodName>registerCompletionItemProvider</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="false"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Deny"/>
          <Attribute key="AllowedLanguages" zh="允许的语言" en="Allowed languages" type="string" default=""/>
          <Attribute key="MaxProviders" type="number" default="5"/>
        </Attributes>
      </ApiMethod>

      <!-- languages.registerHoverProvider -->
      <ApiMethod>
        <Namespace>languages</Namespace>
        <MethodName>registerHoverProvider</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="false"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Deny"/>
          <Attribute key="AllowedLanguages" type="string" default=""/>
        </Attributes>
      </ApiMethod>

      <!-- languages.getDiagnostics -->
      <ApiMethod>
        <Namespace>languages</Namespace>
        <MethodName>getDiagnostics</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
        </Attributes>
      </ApiMethod>

      <!-- ==================== debug 命名空间 ==================== -->

      <!-- debug.startDebugging -->
      <ApiMethod>
        <Namespace>debug</Namespace>
        <MethodName>startDebugging</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="false"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Deny"/>
          <Attribute key="RequireUserApproval" type="boolean" default="true"/>
          <Attribute key="MaxSessions" type="number" default="2"/>
        </Attributes>
      </ApiMethod>

      <!-- debug.registerDebugAdapterDescriptorFactory -->
      <ApiMethod>
        <Namespace>debug</Namespace>
        <MethodName>registerDebugAdapterDescriptorFactory</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="false"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Deny"/>
        </Attributes>
      </ApiMethod>

      <!-- ==================== scm 命名空间 ==================== -->

      <!-- scm.createSourceControl -->
      <ApiMethod>
        <Namespace>scm</Namespace>
        <MethodName>createSourceControl</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="false"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Deny"/>
          <Attribute key="MaxSourceControls" type="number" default="1"/>
        </Attributes>
      </ApiMethod>

      <!-- ==================== extensions 命名空间 ==================== -->

      <!-- extensions.getExtension -->
      <ApiMethod>
        <Namespace>extensions</Namespace>
        <MethodName>getExtension</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Allow"/>
          <Attribute key="AllowListAllExtensions" zh="允许列举所有扩展" en="Allow listing all extensions" type="boolean" default="false"/>
        </Attributes>
      </ApiMethod>

      <!-- ==================== env 命名空间 ==================== -->

      <!-- env.openExternal -->
      <ApiMethod>
        <Namespace>env</Namespace>
        <MethodName>openExternal</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Ask"/>
          <Attribute key="RequireUserApproval" type="boolean" default="true"/>
          <Attribute key="AllowedProtocols" zh="允许的协议" en="Allowed protocols" type="string" default="https,http"/>
          <Attribute key="AllowedDomains" zh="允许的域名" en="Allowed domains" type="string" default=""/>
          <Attribute key="MaxCallsPerHour" type="number" default="10"/>
        </Attributes>
      </ApiMethod>

      <!-- env.clipboard.writeText -->
      <ApiMethod>
        <Namespace>env.clipboard</Namespace>
        <MethodName>writeText</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="true"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Ask"/>
          <Attribute key="RequireUserApproval" type="boolean" default="true"/>
          <Attribute key="MaxTextLength" zh="最大文本长度" en="Max text length" type="number" default="10000"/>
          <Attribute key="MaxCallsPerMinute" type="number" default="5"/>
        </Attributes>
      </ApiMethod>

      <!-- env.clipboard.readText -->
      <ApiMethod>
        <Namespace>env.clipboard</Namespace>
        <MethodName>readText</MethodName>
        <Attributes>
          <Attribute key="Allowed" type="boolean" default="false"/>
          <Attribute key="Action" type="enum" values="Allow,Deny,Ask" default="Deny"/>
          <Attribute key="RequireUserApproval" type="boolean" default="true"/>
        </Attributes>
      </ApiMethod>

    </ApiMethods>

    <!-- API 分组策略 (可选) -->
    <ApiGroups>
      <!-- UI 交互类 API 分组 -->
      <ApiGroup>
        <GroupName>UI_Interaction</GroupName>
        <GroupNameLocalized zh="UI交互" en="UI Interaction"/>
        <Apis>
          <Api>window.showInformationMessage</Api>
          <Api>window.showWarningMessage</Api>
          <Api>window.showErrorMessage</Api>
          <Api>window.showInputBox</Api>
          <Api>window.showQuickPick</Api>
        </Apis>
        <GroupPolicy>
          <MaxTotalCallsPerMinute>50</MaxTotalCallsPerMinute>
          <RequireUserConsent>false</RequireUserConsent>
        </GroupPolicy>
      </ApiGroup>

      <!-- 文件系统类 API 分组 -->
      <ApiGroup>
        <GroupName>FileSystem</GroupName>
        <GroupNameLocalized zh="文件系统" en="File System"/>
        <Apis>
          <Api>workspace.openTextDocument</Api>
          <Api>workspace.findFiles</Api>
          <Api>workspace.createFileSystemWatcher</Api>
        </Apis>
        <GroupPolicy>
          <MaxTotalCallsPerMinute>100</MaxTotalCallsPerMinute>
          <MaxTotalBytesReadPerDay>1073741824</MaxTotalBytesReadPerDay>
        </GroupPolicy>
      </ApiGroup>

      <!-- 敏感操作类 API 分组 -->
      <ApiGroup>
        <GroupName>Sensitive_Operations</GroupName>
        <GroupNameLocalized zh="敏感操作" en="Sensitive Operations"/>
        <Apis>
          <Api>workspace.applyEdit</Api>
          <Api>window.createTerminal</Api>
          <Api>debug.startDebugging</Api>
          <Api>env.openExternal</Api>
          <Api>env.clipboard.writeText</Api>
        </Apis>
        <GroupPolicy>
          <AlwaysRequireUserApproval>true</AlwaysRequireUserApproval>
          <LogAllCalls>true</LogAllCalls>
          <MaxTotalCallsPerHour>20</MaxTotalCallsPerHour>
        </GroupPolicy>
      </ApiGroup>
    </ApiGroups>

  </Resource>

</Resources>
