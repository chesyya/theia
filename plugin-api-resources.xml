<?xml version="1.0" encoding="UTF-8"?>
<!-- Theia 插件 API 权限资源配置 -->
<Resources>

  <!-- 示例1: 完整的插件权限配置 -->
  <Resource>
    <ResourceID>publisher.plugin-name</ResourceID>
    <TargetType>Plugin</TargetType>
    <ResourceName zh="示例插件API权限" en="Example Plugin API Permissions"/>

    <Attributes>

      <!-- ==================== 通用权限属性 ==================== -->

      <!-- API 启用状态 -->
      <Attribute
        key="Enabled"
        zh="是否启用"
        en="Enable plugin APIs"
        type="boolean"
        default="true"/>

      <!-- 权限级别 -->
      <Attribute
        key="PermissionLevel"
        zh="权限级别"
        en="Permission level"
        type="enum"
        values="None,Read,Write,Execute,Full"
        default="Read"/>

      <!-- 信任级别 -->
      <Attribute
        key="TrustLevel"
        zh="信任级别"
        en="Trust level"
        type="enum"
        values="Untrusted,Limited,Trusted,FullyTrusted"
        default="Limited"/>

      <!-- ==================== 调用频率限制 ==================== -->

      <!-- 每秒最大调用次数 -->
      <Attribute
        key="MaxCallsPerSecond"
        zh="每秒最大调用次数"
        en="Max API calls per second"
        type="number"
        min="1"
        max="1000"
        default="100"/>

      <!-- 每分钟最大调用次数 -->
      <Attribute
        key="MaxCallsPerMinute"
        zh="每分钟最大调用次数"
        en="Max API calls per minute"
        type="number"
        min="1"
        max="10000"
        default="1000"/>

      <!-- 每小时最大调用次数 -->
      <Attribute
        key="MaxCallsPerHour"
        zh="每小时最大调用次数"
        en="Max API calls per hour"
        type="number"
        min="1"
        max="100000"
        default="10000"/>

      <!-- 每天最大调用次数 -->
      <Attribute
        key="MaxCallsPerDay"
        zh="每天最大调用次数"
        en="Max API calls per day"
        type="number"
        min="1"
        max="1000000"
        default="100000"/>

      <!-- ==================== 并发控制 ==================== -->

      <!-- 最大并发调用数 -->
      <Attribute
        key="MaxConcurrentCalls"
        zh="最大并发调用数"
        en="Max concurrent API calls"
        type="number"
        min="1"
        max="100"
        default="10"/>

      <!-- 单个API超时时间（毫秒） -->
      <Attribute
        key="ApiTimeout"
        zh="API超时时间(ms)"
        en="API call timeout (ms)"
        type="number"
        min="100"
        max="300000"
        default="30000"/>

      <!-- ==================== 命名空间权限 ==================== -->

      <!-- 允许访问 window 命名空间 -->
      <Attribute
        key="AllowWindowNamespace"
        zh="允许访问window命名空间"
        en="Allow access to window namespace"
        type="boolean"
        default="true"/>

      <!-- 允许访问 workspace 命名空间 -->
      <Attribute
        key="AllowWorkspaceNamespace"
        zh="允许访问workspace命名空间"
        en="Allow access to workspace namespace"
        type="boolean"
        default="true"/>

      <!-- 允许访问 commands 命名空间 -->
      <Attribute
        key="AllowCommandsNamespace"
        zh="允许访问commands命名空间"
        en="Allow access to commands namespace"
        type="boolean"
        default="true"/>

      <!-- 允许访问 languages 命名空间 -->
      <Attribute
        key="AllowLanguagesNamespace"
        zh="允许访问languages命名空间"
        en="Allow access to languages namespace"
        type="boolean"
        default="false"/>

      <!-- 允许访问 debug 命名空间 -->
      <Attribute
        key="AllowDebugNamespace"
        zh="允许访问debug命名空间"
        en="Allow access to debug namespace"
        type="boolean"
        default="false"/>

      <!-- 允许访问 scm 命名空间 -->
      <Attribute
        key="AllowScmNamespace"
        zh="允许访问scm命名空间"
        en="Allow access to scm namespace"
        type="boolean"
        default="false"/>

      <!-- 允许访问 extensions 命名空间 -->
      <Attribute
        key="AllowExtensionsNamespace"
        zh="允许访问extensions命名空间"
        en="Allow access to extensions namespace"
        type="boolean"
        default="false"/>

      <!-- ==================== UI 交互权限 ==================== -->

      <!-- 允许显示信息消息 -->
      <Attribute
        key="AllowShowInformationMessage"
        zh="允许显示信息消息"
        en="Allow showing information messages"
        type="boolean"
        default="true"/>

      <!-- 每小时最大消息数 -->
      <Attribute
        key="MaxMessagesPerHour"
        zh="每小时最大消息显示数"
        en="Max messages per hour"
        type="number"
        min="0"
        max="100"
        default="20"/>

      <!-- 允许显示模态对话框 -->
      <Attribute
        key="AllowModalDialogs"
        zh="允许显示模态对话框"
        en="Allow modal dialogs"
        type="boolean"
        default="false"/>

      <!-- 允许创建 WebView -->
      <Attribute
        key="AllowWebviewCreation"
        zh="允许创建WebView"
        en="Allow creating webviews"
        type="boolean"
        default="false"/>

      <!-- 最大 WebView 数量 -->
      <Attribute
        key="MaxWebviews"
        zh="最大WebView数量"
        en="Max number of webviews"
        type="number"
        min="0"
        max="10"
        default="2"/>

      <!-- ==================== 文件系统权限 ==================== -->

      <!-- 允许文件系统读取 -->
      <Attribute
        key="AllowFileSystemRead"
        zh="允许文件系统读取"
        en="Allow file system read"
        type="boolean"
        default="true"/>

      <!-- 允许文件系统写入 -->
      <Attribute
        key="AllowFileSystemWrite"
        zh="允许文件系统写入"
        en="Allow file system write"
        type="boolean"
        default="false"/>

      <!-- 文件访问路径模式（支持 glob） -->
      <Attribute
        key="FileAccessPattern"
        zh="文件访问路径模式"
        en="File access path pattern"
        type="string"
        default="**/*"/>

      <!-- 禁止访问的路径模式 -->
      <Attribute
        key="FileAccessDenyPattern"
        zh="禁止访问路径"
        en="Denied file access patterns"
        type="string"
        default="**/node_modules/**,**/.git/**"/>

      <!-- 单次读取最大文件大小（字节） -->
      <Attribute
        key="MaxFileReadSize"
        zh="单次最大文件读取大小(字节)"
        en="Max file read size (bytes)"
        type="number"
        min="1024"
        max="104857600"
        default="10485760"/>

      <!-- 每天最大文件读取总量（字节） -->
      <Attribute
        key="MaxFilesReadPerDay"
        zh="每天最大文件读取总量(字节)"
        en="Max total bytes read per day"
        type="number"
        min="1048576"
        max="10737418240"
        default="1073741824"/>

      <!-- 允许文件监听 -->
      <Attribute
        key="AllowFileWatch"
        zh="允许文件监听"
        en="Allow file watching"
        type="boolean"
        default="true"/>

      <!-- 最大文件监听数 -->
      <Attribute
        key="MaxFileWatchers"
        zh="最大文件监听数"
        en="Max file watchers"
        type="number"
        min="0"
        max="1000"
        default="100"/>

      <!-- ==================== 编辑器权限 ==================== -->

      <!-- 允许文档编辑 -->
      <Attribute
        key="AllowDocumentEdit"
        zh="允许文档编辑"
        en="Allow document editing"
        type="boolean"
        default="false"/>

      <!-- 允许打开文本文档 -->
      <Attribute
        key="AllowOpenTextDocument"
        zh="允许打开文本文档"
        en="Allow opening text documents"
        type="boolean"
        default="true"/>

      <!-- 允许显示文本文档 -->
      <Attribute
        key="AllowShowTextDocument"
        zh="允许显示文本文档"
        en="Allow showing text documents"
        type="boolean"
        default="true"/>

      <!-- 最大同时打开文档数 -->
      <Attribute
        key="MaxOpenDocuments"
        zh="最大同时打开文档数"
        en="Max concurrent open documents"
        type="number"
        min="1"
        max="100"
        default="20"/>

      <!-- ==================== 命令执行权限 ==================== -->

      <!-- 允许注册命令 -->
      <Attribute
        key="AllowRegisterCommand"
        zh="允许注册命令"
        en="Allow registering commands"
        type="boolean"
        default="true"/>

      <!-- 最大注册命令数 -->
      <Attribute
        key="MaxRegisteredCommands"
        zh="最大注册命令数"
        en="Max registered commands"
        type="number"
        min="1"
        max="100"
        default="20"/>

      <!-- 允许执行命令 -->
      <Attribute
        key="AllowExecuteCommand"
        zh="允许执行命令"
        en="Allow executing commands"
        type="boolean"
        default="true"/>

      <!-- 允许执行的命令白名单（逗号分隔） -->
      <Attribute
        key="CommandWhitelist"
        zh="命令白名单"
        en="Command whitelist"
        type="string"
        default=""/>

      <!-- 禁止执行的命令黑名单（逗号分隔） -->
      <Attribute
        key="CommandBlacklist"
        zh="命令黑名单"
        en="Command blacklist"
        type="string"
        default=""/>

      <!-- ==================== 网络权限 ==================== -->

      <!-- 允许网络访问 -->
      <Attribute
        key="AllowNetworkAccess"
        zh="允许网络访问"
        en="Allow network access"
        type="boolean"
        default="false"/>

      <!-- 允许的域名列表（逗号分隔） -->
      <Attribute
        key="AllowedDomains"
        zh="允许的域名列表"
        en="Allowed domains"
        type="string"
        default=""/>

      <!-- 每天最大网络请求数 -->
      <Attribute
        key="MaxNetworkRequestsPerDay"
        zh="每天最大网络请求数"
        en="Max network requests per day"
        type="number"
        min="0"
        max="10000"
        default="100"/>

      <!-- 网络请求超时（毫秒） -->
      <Attribute
        key="NetworkTimeout"
        zh="网络请求超时(ms)"
        en="Network request timeout (ms)"
        type="number"
        min="1000"
        max="300000"
        default="30000"/>

      <!-- ==================== 时间限制 ==================== -->

      <!-- 允许使用开始时间（格式: HH:mm） -->
      <Attribute
        key="AllowedStartTime"
        zh="允许使用开始时间"
        en="Allowed start time"
        type="time"
        default="00:00"/>

      <!-- 允许使用结束时间（格式: HH:mm） -->
      <Attribute
        key="AllowedEndTime"
        zh="允许使用结束时间"
        en="Allowed end time"
        type="time"
        default="23:59"/>

      <!-- 允许使用的星期（1-7，逗号分隔，1=周一） -->
      <Attribute
        key="AllowedDaysOfWeek"
        zh="允许使用的星期"
        en="Allowed days of week"
        type="string"
        default="1,2,3,4,5,6,7"/>

      <!-- 权限过期时间（ISO 8601 格式） -->
      <Attribute
        key="ExpirationDate"
        zh="权限过期时间"
        en="Permission expiration date"
        type="datetime"
        default="2099-12-31T23:59:59Z"/>

      <!-- ==================== 资源配额 ==================== -->

      <!-- CPU 使用率限制（百分比） -->
      <Attribute
        key="MaxCpuUsage"
        zh="CPU使用率限制(%)"
        en="Max CPU usage (%)"
        type="number"
        min="1"
        max="100"
        default="30"/>

      <!-- 内存使用限制（MB） -->
      <Attribute
        key="MaxMemoryUsage"
        zh="内存使用限制(MB)"
        en="Max memory usage (MB)"
        type="number"
        min="10"
        max="2048"
        default="256"/>

      <!-- ==================== 语言服务权限 ==================== -->

      <!-- 允许注册语言提供者 -->
      <Attribute
        key="AllowRegisterLanguageProvider"
        zh="允许注册语言提供者"
        en="Allow registering language providers"
        type="boolean"
        default="false"/>

      <!-- 允许的语言ID列表（逗号分隔） -->
      <Attribute
        key="AllowedLanguages"
        zh="允许的语言列表"
        en="Allowed language IDs"
        type="string"
        default=""/>

      <!-- ==================== 调试权限 ==================== -->

      <!-- 允许启动调试会话 -->
      <Attribute
        key="AllowDebugSession"
        zh="允许启动调试会话"
        en="Allow starting debug sessions"
        type="boolean"
        default="false"/>

      <!-- 最大调试会话数 -->
      <Attribute
        key="MaxDebugSessions"
        zh="最大调试会话数"
        en="Max debug sessions"
        type="number"
        min="0"
        max="10"
        default="1"/>

      <!-- ==================== 终端权限 ==================== -->

      <!-- 允许创建终端 -->
      <Attribute
        key="AllowCreateTerminal"
        zh="允许创建终端"
        en="Allow creating terminals"
        type="boolean"
        default="false"/>

      <!-- 最大终端数量 -->
      <Attribute
        key="MaxTerminals"
        zh="最大终端数量"
        en="Max terminals"
        type="number"
        min="0"
        max="10"
        default="2"/>

      <!-- 允许向终端发送文本 -->
      <Attribute
        key="AllowSendTextToTerminal"
        zh="允许向终端发送文本"
        en="Allow sending text to terminal"
        type="boolean"
        default="false"/>

      <!-- ==================== 配置权限 ==================== -->

      <!-- 允许读取配置 -->
      <Attribute
        key="AllowReadConfiguration"
        zh="允许读取配置"
        en="Allow reading configuration"
        type="boolean"
        default="true"/>

      <!-- 允许修改配置 -->
      <Attribute
        key="AllowUpdateConfiguration"
        zh="允许修改配置"
        en="Allow updating configuration"
        type="boolean"
        default="false"/>

      <!-- 配置访问范围 -->
      <Attribute
        key="ConfigurationScope"
        zh="配置访问范围"
        en="Configuration access scope"
        type="enum"
        values="Global,Workspace,WorkspaceFolder,Self"
        default="Self"/>

      <!-- ==================== 安全相关 ==================== -->

      <!-- 需要用户确认敏感操作 -->
      <Attribute
        key="RequireUserConfirmation"
        zh="敏感操作需要用户确认"
        en="Require user confirmation for sensitive operations"
        type="boolean"
        default="true"/>

      <!-- 允许访问敏感 API -->
      <Attribute
        key="AllowSensitiveApis"
        zh="允许访问敏感API"
        en="Allow access to sensitive APIs"
        type="boolean"
        default="false"/>

      <!-- API 调用日志级别 -->
      <Attribute
        key="ApiLogLevel"
        zh="API调用日志级别"
        en="API call log level"
        type="enum"
        values="None,Error,Warn,Info,Debug,Trace"
        default="Warn"/>

    </Attributes>
  </Resource>


  <!-- ==================== 预定义权限模板 ==================== -->

  <!-- 模板1: 受限插件（最小权限） -->
  <Resource>
    <ResourceID>template.restricted</ResourceID>
    <TargetType>PluginTemplate</TargetType>
    <ResourceName zh="受限插件模板" en="Restricted Plugin Template"/>
    <Attributes>
      <Attribute key="PermissionLevel" type="enum" default="Read"/>
      <Attribute key="TrustLevel" type="enum" default="Untrusted"/>
      <Attribute key="MaxCallsPerSecond" type="number" default="10"/>
      <Attribute key="AllowFileSystemWrite" type="boolean" default="false"/>
      <Attribute key="AllowDocumentEdit" type="boolean" default="false"/>
      <Attribute key="AllowNetworkAccess" type="boolean" default="false"/>
      <Attribute key="AllowModalDialogs" type="boolean" default="false"/>
      <Attribute key="AllowWebviewCreation" type="boolean" default="false"/>
      <Attribute key="AllowCreateTerminal" type="boolean" default="false"/>
      <Attribute key="MaxMemoryUsage" type="number" default="128"/>
    </Attributes>
  </Resource>

  <!-- 模板2: 标准插件（常用权限） -->
  <Resource>
    <ResourceID>template.standard</ResourceID>
    <TargetType>PluginTemplate</TargetType>
    <ResourceName zh="标准插件模板" en="Standard Plugin Template"/>
    <Attributes>
      <Attribute key="PermissionLevel" type="enum" default="Write"/>
      <Attribute key="TrustLevel" type="enum" default="Limited"/>
      <Attribute key="MaxCallsPerSecond" type="number" default="100"/>
      <Attribute key="AllowFileSystemWrite" type="boolean" default="true"/>
      <Attribute key="AllowDocumentEdit" type="boolean" default="true"/>
      <Attribute key="AllowNetworkAccess" type="boolean" default="false"/>
      <Attribute key="AllowModalDialogs" type="boolean" default="true"/>
      <Attribute key="AllowWebviewCreation" type="boolean" default="true"/>
      <Attribute key="MaxWebviews" type="number" default="2"/>
      <Attribute key="MaxMemoryUsage" type="number" default="256"/>
    </Attributes>
  </Resource>

  <!-- 模板3: 完全信任插件 -->
  <Resource>
    <ResourceID>template.fulltrust</ResourceID>
    <TargetType>PluginTemplate</TargetType>
    <ResourceName zh="完全信任插件模板" en="Fully Trusted Plugin Template"/>
    <Attributes>
      <Attribute key="PermissionLevel" type="enum" default="Full"/>
      <Attribute key="TrustLevel" type="enum" default="FullyTrusted"/>
      <Attribute key="MaxCallsPerSecond" type="number" default="1000"/>
      <Attribute key="AllowFileSystemWrite" type="boolean" default="true"/>
      <Attribute key="AllowDocumentEdit" type="boolean" default="true"/>
      <Attribute key="AllowNetworkAccess" type="boolean" default="true"/>
      <Attribute key="AllowModalDialogs" type="boolean" default="true"/>
      <Attribute key="AllowWebviewCreation" type="boolean" default="true"/>
      <Attribute key="AllowCreateTerminal" type="boolean" default="true"/>
      <Attribute key="AllowDebugSession" type="boolean" default="true"/>
      <Attribute key="AllowRegisterLanguageProvider" type="boolean" default="true"/>
      <Attribute key="RequireUserConfirmation" type="boolean" default="false"/>
      <Attribute key="MaxMemoryUsage" type="number" default="1024"/>
    </Attributes>
  </Resource>

  <!-- 模板4: 只读插件 -->
  <Resource>
    <ResourceID>template.readonly</ResourceID>
    <TargetType>PluginTemplate</TargetType>
    <ResourceName zh="只读插件模板" en="Read-only Plugin Template"/>
    <Attributes>
      <Attribute key="PermissionLevel" type="enum" default="Read"/>
      <Attribute key="TrustLevel" type="enum" default="Limited"/>
      <Attribute key="AllowFileSystemWrite" type="boolean" default="false"/>
      <Attribute key="AllowDocumentEdit" type="boolean" default="false"/>
      <Attribute key="AllowUpdateConfiguration" type="boolean" default="false"/>
      <Attribute key="AllowRegisterCommand" type="boolean" default="false"/>
      <Attribute key="AllowShowInformationMessage" type="boolean" default="true"/>
      <Attribute key="MaxMessagesPerHour" type="number" default="5"/>
    </Attributes>
  </Resource>

</Resources>
