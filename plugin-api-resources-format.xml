<?xml version="1.0" encoding="UTF-8"?>
<Resources>

  <!-- 示例插件1: 标准插件 -->
  <Resource>
    <ResourceID>publisher.my-plugin</ResourceID>
    <TargetType>Plugin</TargetType>
    <ResourceName zh="我的插件" en="My Plugin"/>
    <Attributes>

      <!-- window 命名空间 API -->
      <Attribute key="window.showInformationMessage"
                 zh="显示信息消息"
                 en="Show information message"
                 type="boolean"
                 default="true"/>

      <Attribute key="window.showWarningMessage"
                 zh="显示警告消息"
                 en="Show warning message"
                 type="boolean"
                 default="true"/>

      <Attribute key="window.showErrorMessage"
                 zh="显示错误消息"
                 en="Show error message"
                 type="boolean"
                 default="true"/>

      <Attribute key="window.showInputBox"
                 zh="显示输入框"
                 en="Show input box"
                 type="boolean"
                 default="true"/>

      <Attribute key="window.showQuickPick"
                 zh="显示快速选择"
                 en="Show quick pick"
                 type="boolean"
                 default="true"/>

      <Attribute key="window.createWebviewPanel"
                 zh="创建WebView面板"
                 en="Create webview panel"
                 type="boolean"
                 default="false"/>

      <Attribute key="window.createTerminal"
                 zh="创建终端"
                 en="Create terminal"
                 type="boolean"
                 default="false"/>

      <Attribute key="window.showTextDocument"
                 zh="显示文本文档"
                 en="Show text document"
                 type="boolean"
                 default="true"/>

      <!-- workspace 命名空间 API -->
      <Attribute key="workspace.openTextDocument"
                 zh="打开文本文档"
                 en="Open text document"
                 type="boolean"
                 default="true"/>

      <Attribute key="workspace.findFiles"
                 zh="查找文件"
                 en="Find files"
                 type="boolean"
                 default="true"/>

      <Attribute key="workspace.getConfiguration"
                 zh="获取配置"
                 en="Get configuration"
                 type="boolean"
                 default="true"/>

      <Attribute key="workspace.applyEdit"
                 zh="应用编辑"
                 en="Apply edit"
                 type="boolean"
                 default="false"/>

      <Attribute key="workspace.createFileSystemWatcher"
                 zh="创建文件监听器"
                 en="Create file system watcher"
                 type="boolean"
                 default="true"/>

      <!-- commands 命名空间 API -->
      <Attribute key="commands.registerCommand"
                 zh="注册命令"
                 en="Register command"
                 type="boolean"
                 default="true"/>

      <Attribute key="commands.executeCommand"
                 zh="执行命令"
                 en="Execute command"
                 type="boolean"
                 default="true"/>

      <Attribute key="commands.getCommands"
                 zh="获取命令列表"
                 en="Get commands"
                 type="boolean"
                 default="true"/>

      <!-- languages 命名空间 API -->
      <Attribute key="languages.registerCompletionItemProvider"
                 zh="注册代码补全提供者"
                 en="Register completion item provider"
                 type="boolean"
                 default="false"/>

      <Attribute key="languages.registerHoverProvider"
                 zh="注册悬停提示提供者"
                 en="Register hover provider"
                 type="boolean"
                 default="false"/>

      <Attribute key="languages.getDiagnostics"
                 zh="获取诊断信息"
                 en="Get diagnostics"
                 type="boolean"
                 default="true"/>

      <!-- debug 命名空间 API -->
      <Attribute key="debug.startDebugging"
                 zh="启动调试"
                 en="Start debugging"
                 type="boolean"
                 default="false"/>

      <!-- env 命名空间 API -->
      <Attribute key="env.openExternal"
                 zh="打开外部链接"
                 en="Open external"
                 type="boolean"
                 default="true"/>

      <Attribute key="env.clipboard.writeText"
                 zh="写入剪贴板"
                 en="Write to clipboard"
                 type="boolean"
                 default="true"/>

      <Attribute key="env.clipboard.readText"
                 zh="读取剪贴板"
                 en="Read from clipboard"
                 type="boolean"
                 default="false"/>

      <!-- 可选: API 调用频率限制 -->
      <Attribute key="MaxApiCallsPerMinute"
                 zh="每分钟最大API调用次数"
                 en="Max API calls per minute"
                 type="number"
                 min="1"
                 max="1000"
                 default="100"/>

    </Attributes>
  </Resource>

  <!-- 示例插件2: 只读插件 -->
  <Resource>
    <ResourceID>readonly.code-analyzer</ResourceID>
    <TargetType>Plugin</TargetType>
    <ResourceName zh="代码分析器(只读)" en="Code Analyzer (Read-only)"/>
    <Attributes>

      <!-- 只允许读取相关的 API -->
      <Attribute key="window.showInformationMessage" type="boolean" default="true"/>
      <Attribute key="workspace.openTextDocument" type="boolean" default="true"/>
      <Attribute key="workspace.findFiles" type="boolean" default="true"/>
      <Attribute key="workspace.getConfiguration" type="boolean" default="true"/>

      <!-- 禁止所有写操作 -->
      <Attribute key="workspace.applyEdit" type="boolean" default="false"/>
      <Attribute key="window.createTerminal" type="boolean" default="false"/>
      <Attribute key="window.createWebviewPanel" type="boolean" default="false"/>
      <Attribute key="commands.registerCommand" type="boolean" default="false"/>
      <Attribute key="env.openExternal" type="boolean" default="false"/>

      <!-- 严格的频率限制 -->
      <Attribute key="MaxApiCallsPerMinute" type="number" min="1" max="1000" default="10"/>

    </Attributes>
  </Resource>

  <!-- 示例插件3: Git 集成 (完全权限) -->
  <Resource>
    <ResourceID>vscode.git</ResourceID>
    <TargetType>Plugin</TargetType>
    <ResourceName zh="Git版本控制" en="Git SCM Integration"/>
    <Attributes>

      <!-- 允许所有常用 API -->
      <Attribute key="window.showInformationMessage" type="boolean" default="true"/>
      <Attribute key="window.showWarningMessage" type="boolean" default="true"/>
      <Attribute key="window.showErrorMessage" type="boolean" default="true"/>
      <Attribute key="window.showInputBox" type="boolean" default="true"/>
      <Attribute key="window.showQuickPick" type="boolean" default="true"/>
      <Attribute key="window.createTerminal" type="boolean" default="true"/>

      <Attribute key="workspace.openTextDocument" type="boolean" default="true"/>
      <Attribute key="workspace.findFiles" type="boolean" default="true"/>
      <Attribute key="workspace.getConfiguration" type="boolean" default="true"/>
      <Attribute key="workspace.applyEdit" type="boolean" default="true"/>
      <Attribute key="workspace.createFileSystemWatcher" type="boolean" default="true"/>

      <Attribute key="commands.registerCommand" type="boolean" default="true"/>
      <Attribute key="commands.executeCommand" type="boolean" default="true"/>

      <Attribute key="scm.createSourceControl" type="boolean" default="true"/>

      <Attribute key="env.openExternal" type="boolean" default="true"/>

      <!-- 宽松的频率限制 -->
      <Attribute key="MaxApiCallsPerMinute" type="number" min="1" max="1000" default="500"/>

    </Attributes>
  </Resource>

  <!-- 示例插件4: 第三方未信任插件 -->
  <Resource>
    <ResourceID>untrusted.third-party</ResourceID>
    <TargetType>Plugin</TargetType>
    <ResourceName zh="未信任的第三方插件" en="Untrusted Third-party Plugin"/>
    <Attributes>

      <!-- 最小权限 - 只允许最基本的 API -->
      <Attribute key="window.showInformationMessage" type="boolean" default="true"/>
      <Attribute key="workspace.openTextDocument" type="boolean" default="true"/>
      <Attribute key="workspace.getConfiguration" type="boolean" default="true"/>

      <!-- 禁止所有危险操作 -->
      <Attribute key="window.createTerminal" type="boolean" default="false"/>
      <Attribute key="window.createWebviewPanel" type="boolean" default="false"/>
      <Attribute key="workspace.applyEdit" type="boolean" default="false"/>
      <Attribute key="commands.executeCommand" type="boolean" default="false"/>
      <Attribute key="commands.registerCommand" type="boolean" default="false"/>
      <Attribute key="env.openExternal" type="boolean" default="false"/>
      <Attribute key="env.clipboard.readText" type="boolean" default="false"/>
      <Attribute key="env.clipboard.writeText" type="boolean" default="false"/>
      <Attribute key="debug.startDebugging" type="boolean" default="false"/>

      <!-- 非常严格的频率限制 -->
      <Attribute key="MaxApiCallsPerMinute" type="number" min="1" max="1000" default="5"/>

    </Attributes>
  </Resource>

  <!-- 示例插件5: TypeScript 语言服务 -->
  <Resource>
    <ResourceID>vscode.typescript-language-features</ResourceID>
    <TargetType>Plugin</TargetType>
    <ResourceName zh="TypeScript语言服务" en="TypeScript Language Features"/>
    <Attributes>

      <!-- 文件操作 -->
      <Attribute key="workspace.openTextDocument" type="boolean" default="true"/>
      <Attribute key="workspace.findFiles" type="boolean" default="true"/>
      <Attribute key="workspace.createFileSystemWatcher" type="boolean" default="true"/>
      <Attribute key="workspace.getConfiguration" type="boolean" default="true"/>

      <!-- 语言服务 API -->
      <Attribute key="languages.registerCompletionItemProvider" type="boolean" default="true"/>
      <Attribute key="languages.registerHoverProvider" type="boolean" default="true"/>
      <Attribute key="languages.registerDefinitionProvider" type="boolean" default="true"/>
      <Attribute key="languages.registerReferenceProvider" type="boolean" default="true"/>
      <Attribute key="languages.registerDocumentSymbolProvider" type="boolean" default="true"/>
      <Attribute key="languages.registerCodeActionsProvider" type="boolean" default="true"/>
      <Attribute key="languages.getDiagnostics" type="boolean" default="true"/>
      <Attribute key="languages.createDiagnosticCollection" type="boolean" default="true"/>

      <!-- UI -->
      <Attribute key="window.showInformationMessage" type="boolean" default="true"/>
      <Attribute key="window.showErrorMessage" type="boolean" default="true"/>

      <!-- 命令 -->
      <Attribute key="commands.registerCommand" type="boolean" default="true"/>
      <Attribute key="commands.executeCommand" type="boolean" default="true"/>

      <!-- 高频调用限制 -->
      <Attribute key="MaxApiCallsPerMinute" type="number" min="1" max="10000" default="1000"/>

    </Attributes>
  </Resource>

  <!-- 示例插件6: 代码格式化工具 -->
  <Resource>
    <ResourceID>formatter.prettier</ResourceID>
    <TargetType>Plugin</TargetType>
    <ResourceName zh="代码格式化工具" en="Code Formatter"/>
    <Attributes>

      <!-- 文件读写 -->
      <Attribute key="workspace.openTextDocument" type="boolean" default="true"/>
      <Attribute key="workspace.applyEdit" type="boolean" default="true"/>
      <Attribute key="workspace.getConfiguration" type="boolean" default="true"/>

      <!-- UI 反馈 -->
      <Attribute key="window.showInformationMessage" type="boolean" default="true"/>
      <Attribute key="window.showErrorMessage" type="boolean" default="true"/>

      <!-- 命令注册 -->
      <Attribute key="commands.registerCommand" type="boolean" default="true"/>

      <!-- 禁止危险操作 -->
      <Attribute key="window.createTerminal" type="boolean" default="false"/>
      <Attribute key="env.openExternal" type="boolean" default="false"/>

      <Attribute key="MaxApiCallsPerMinute" type="number" min="1" max="1000" default="50"/>

    </Attributes>
  </Resource>

  <!-- 示例插件7: 调试器 -->
  <Resource>
    <ResourceID>vscode.node-debug</ResourceID>
    <TargetType>Plugin</TargetType>
    <ResourceName zh="Node.js调试器" en="Node.js Debugger"/>
    <Attributes>

      <!-- 调试 API -->
      <Attribute key="debug.startDebugging" type="boolean" default="true"/>
      <Attribute key="debug.registerDebugAdapterDescriptorFactory" type="boolean" default="true"/>
      <Attribute key="debug.registerDebugConfigurationProvider" type="boolean" default="true"/>

      <!-- 终端 -->
      <Attribute key="window.createTerminal" type="boolean" default="true"/>

      <!-- 文件操作 -->
      <Attribute key="workspace.openTextDocument" type="boolean" default="true"/>
      <Attribute key="workspace.findFiles" type="boolean" default="true"/>

      <!-- UI -->
      <Attribute key="window.showInformationMessage" type="boolean" default="true"/>
      <Attribute key="window.showErrorMessage" type="boolean" default="true"/>

      <!-- 命令 -->
      <Attribute key="commands.registerCommand" type="boolean" default="true"/>
      <Attribute key="commands.executeCommand" type="boolean" default="true"/>

      <Attribute key="MaxApiCallsPerMinute" type="number" min="1" max="1000" default="200"/>

    </Attributes>
  </Resource>

</Resources>
