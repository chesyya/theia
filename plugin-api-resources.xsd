<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- 根元素 -->
  <xs:element name="Resources">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Resource" type="ResourceType" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Resource 类型定义 -->
  <xs:complexType name="ResourceType">
    <xs:sequence>
      <xs:element name="ResourceID" type="xs:string"/>
      <xs:element name="TargetType" type="TargetTypeEnum"/>
      <xs:element name="ResourceName" type="LocalizedNameType"/>
      <xs:element name="Attributes" type="AttributesType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- TargetType 枚举 -->
  <xs:simpleType name="TargetTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Plugin"/>
      <xs:enumeration value="PluginTemplate"/>
      <xs:enumeration value="IDE"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 本地化名称类型 -->
  <xs:complexType name="LocalizedNameType">
    <xs:attribute name="zh" type="xs:string" use="required"/>
    <xs:attribute name="en" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Attributes 类型定义 -->
  <xs:complexType name="AttributesType">
    <xs:sequence>
      <xs:element name="Attribute" type="AttributeType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Attribute 类型定义 -->
  <xs:complexType name="AttributeType">
    <xs:attribute name="key" type="xs:string" use="required"/>
    <xs:attribute name="zh" type="xs:string" use="optional"/>
    <xs:attribute name="en" type="xs:string" use="optional"/>
    <xs:attribute name="type" type="AttributeDataTypeEnum" use="required"/>
    <xs:attribute name="min" type="xs:decimal" use="optional"/>
    <xs:attribute name="max" type="xs:decimal" use="optional"/>
    <xs:attribute name="default" type="xs:string" use="required"/>
    <xs:attribute name="values" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- 属性数据类型枚举 -->
  <xs:simpleType name="AttributeDataTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="boolean"/>
      <xs:enumeration value="number"/>
      <xs:enumeration value="string"/>
      <xs:enumeration value="enum"/>
      <xs:enumeration value="time"/>
      <xs:enumeration value="datetime"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
